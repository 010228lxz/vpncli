#!/usr/bin/env bash
#
# vpnctl — bring up and self-supervise an openfortivpn tunnel.
#
# Portable across macOS (Intel/ARM) and Linux. Code is read-only and may live in
# a Homebrew prefix; per-machine config and state live under the user's home
# (XDG dirs), so this survives `brew install`. See `vpnctl doctor` / `setup`.

set -u

# Everything this tool writes (config, logs, pid, temp files) is owner-only.
umask 077

# ---------------------------------------------------------------------------
# Sourced vs executed. `return` only succeeds when this file is being sourced
# (e.g. `. bin/vpnctl` from a test harness) — when run normally (`./vpnctl` or
# `bash vpnctl`) it's a top-level script and `return` fails. This lets
# tests/*.bats source the file to exercise its functions directly without
# also triggering the final subcommand dispatch (and without needing argv).
if (return 0 2>/dev/null); then
    VPNCTL_SOURCED=1
else
    VPNCTL_SOURCED=0
fi

# ---------------------------------------------------------------------------
# Resolve our own real path (through symlinks, e.g. Homebrew's bin symlink) so
# we can find the libexec helper and re-exec ourselves as the monitor daemon.
# ---------------------------------------------------------------------------
_src="${BASH_SOURCE[0]:-$0}"
while [ -h "$_src" ]; do
    _dir="$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)"
    _link="$(readlink "$_src")"
    case "$_link" in
        /*) _src="$_link" ;;
        *)  _src="$_dir/$_link" ;;
    esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$_src")" >/dev/null 2>&1 && pwd)"
SELF="$SCRIPT_DIR/$(basename "$_src")"
PROG="$(basename "$_src")"

OS="$(uname -s)"
USER="${USER:-$(id -un)}"

# ---------------------------------------------------------------------------
# Config / state locations (XDG, overridable). Code is found relative to SELF.
# ---------------------------------------------------------------------------
CONFIG_DIR="${VPNCLI_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/vpncli}"
STATE_DIR="${VPNCLI_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/vpncli}"
CONFIG_PATH="$CONFIG_DIR/vpn.conf"
SETTINGS_FILE="$CONFIG_DIR/settings"
LOG_FILE="$STATE_DIR/vpn.log"
PID_FILE="$STATE_DIR/vpn.pid"
MONITOR_LOCK_DIR="$STATE_DIR/monitor.lock"
MONITOR_OWNER_FILE="$MONITOR_LOCK_DIR/owner"
MONITOR_READY_FILE="$STATE_DIR/monitor.ready"

# ---------------------------------------------------------------------------
# Defaults (override any of these in $SETTINGS_FILE).
# ---------------------------------------------------------------------------
VERSION="0.1.15"
VPN_TYPE="fortivpn"                   # fortivpn | openvpn — which backend to drive
OPENFORTIVPN=""                       # empty → auto-detect
OPENVPN=""                            # empty → auto-detect (openvpn backend)
OPENVPN_USERNAME=""                   # openvpn auth-user-pass username (openvpn backend)
VPNCTL_HELPER=""                      # optional root-owned helper override
TUN_IFACE=""                          # pin the tunnel iface name (openvpn on macOS: utun names are assigned dynamically and can't be scoped as precisely as ppp*/tun*; set e.g. TUN_IFACE=utun4)
SECRET_SERVICE="vpncli"               # secret store service/account label
SECRET_BACKEND="auto"                 # auto | security | secret-tool | pass
OTP_SEPARATOR=""                      # inserted between password and OTP code (most RADIUS/2FA gateways want none — i.e. password immediately followed by the 6-digit code)
INTERVAL=10                           # seconds between health checks
CONNECT_GRACE=20                      # seconds to let a fresh tunnel come up
HALF_OPEN_CHECKS=3                    # "process up, no tunnel iface" checks before reconnect
MAX_LOG_BYTES=1048576                 # rotate vpn.log past 1 MB
STARTUP_TIMEOUT=30                     # seconds to wait for monitor readiness
SUDOERS_PATH="/etc/sudoers.d/vpncli"  # where the generated rule is installed

if [ -f "$SETTINGS_FILE" ]; then
    # shellcheck disable=SC1090
    . "$SETTINGS_FILE"
fi

# Per-backend config file: fortivpn uses key=value vpn.conf; openvpn uses a
# provider-supplied .ovpn client config (different syntax, so a separate file).
OPENVPN_CONFIG_PATH="$CONFIG_DIR/vpn.ovpn"
# Regenerated fresh before every launch (never committed); fixed path so it can
# be named exactly in the generated sudoers rule, same as the config path.
OPENVPN_AUTH_FILE="$STATE_DIR/openvpn.auth"

TUNNEL_PID=""
MONITOR_TOKEN=""

# ===========================================================================
# Helpers
# ===========================================================================

log() {
    mkdir -p "$STATE_DIR" 2>/dev/null
    printf '%s: %s\n' "$(date)" "$*" >> "$LOG_FILE"
}

validate_settings() {
    local name value
    case "${VPN_TYPE:-}" in
        fortivpn|openvpn) ;;
        *)
            echo "Error: VPN_TYPE must be 'fortivpn' or 'openvpn' (got '${VPN_TYPE:-unset}')." >&2
            return 1
            ;;
    esac
    case "${SECRET_BACKEND:-}" in
        auto|security|secret-tool|pass) ;;
        *)
            echo "Error: SECRET_BACKEND must be auto, security, secret-tool, or pass." >&2
            return 1
            ;;
    esac
    [ -n "${SECRET_SERVICE:-}" ] || {
        echo "Error: SECRET_SERVICE must not be empty." >&2
        return 1
    }
    case "$SECRET_SERVICE" in
        *[[:space:]]*)
            echo "Error: SECRET_SERVICE must not contain whitespace." >&2
            return 1
            ;;
    esac
    for name in INTERVAL CONNECT_GRACE HALF_OPEN_CHECKS MAX_LOG_BYTES STARTUP_TIMEOUT; do
        value="${!name:-}"
        [[ "$value" =~ ^[1-9][0-9]*$ ]] || {
            echo "Error: $name must be a positive integer." >&2
            return 1
        }
    done
    if [ -n "${TUN_IFACE:-}" ] && ! [[ "$TUN_IFACE" =~ ^(tun|utun)[0-9]+$ ]]; then
        echo "Error: TUN_IFACE must match tunN or utunN." >&2
        return 1
    fi
    for name in CONFIG_DIR STATE_DIR SUDOERS_PATH OPENFORTIVPN OPENVPN VPNCTL_HELPER; do
        value="${!name:-}"
        if [ -n "$value" ] && [[ "$value" != /* ]]; then
            echo "Error: $name must be an absolute path when set." >&2
            return 1
        fi
        case "$value" in
            *[[:space:]]*)
                echo "Error: $name must not contain whitespace." >&2
                return 1
                ;;
        esac
    done
}

print_banner() {
    cat <<EOF
 _ __  __ _ __   __ ___| |  ___
| '_ \/ _\` |\ \ / /|  __| | / _ \\
| |_) | (_| | \ V / | |__| ||  __/
| .__/ \__,_|  \_/  \___|_| \___|
|_|
vpnctl — self-supervising VPN tunnel manager
Version: $VERSION
EOF
}

usage() {
    cat <<EOF
$(print_banner)

Usage: $PROG <command>

  start              Start the background monitor (auto-reconnecting tunnel)
  stop               Stop the monitor; its trap tears the tunnel down
  restart
  switch <backend>   Switch to fortivpn|openvpn (persists to settings); if the
                     target backend is already fully configured (config,
                     password, sudoers — each independent per backend) this
                     needs no re-entry and restarts the monitor if it was
                     running. Otherwise it lists exactly what's still missing
  status             Monitor + tunnel state
  routes             VPN routes, and whether it's a FULL or SPLIT tunnel
  logs [-f]          Show (or follow) the log
  doctor             Diagnostics — run this first when anything is wrong
  setup              First-run setup: config + password + sudoers
  set-password       Store the VPN password in the OS secret store (scoped to
                     the active backend — fortivpn and openvpn each keep
                     their own password, so switching never mixes them up)
  set-otp-secret     Store a TOTP seed; a fresh 6-digit code is appended to
                     the password on every connect (for password+OTP
                     gateways). Also scoped to the active backend only — e.g.
                     you can require OTP on openvpn while fortivpn stays
                     password-only, with no cross-contamination either way
  unset-otp-secret   Remove the stored TOTP seed (active backend only)
  install-sudoers    (Re)install the passwordless-sudo rule for the active
                     backend (fortivpn and openvpn each get their own rule
                     file, so installing one never removes the other's)
  uninstall-sudoers [--all]
                     Remove the active backend's passwordless-sudo rule
                     (--all removes both backends' rules)
  version             Show the current version

Config:  $CONFIG_PATH  (openvpn: $OPENVPN_CONFIG_PATH)
State:   $STATE_DIR
Backend: $VPN_TYPE   (set VPN_TYPE=fortivpn|openvpn in $SETTINGS_FILE, or: $PROG switch <backend>)
EOF
    exit 1
}

# Find a bundled asset (helper or template) across installed + dev layouts.
find_asset() {
    local f="$1" c
    for c in \
        "$SCRIPT_DIR/../libexec/$f" \
        "$SCRIPT_DIR/../share/vpncli/$f" \
        "$SCRIPT_DIR/../share/$f" \
        "$SCRIPT_DIR/$f" \
        "$SCRIPT_DIR/../$f"; do
        if [ -e "$c" ]; then printf '%s\n' "$c"; return 0; fi
    done
    return 1
}

detect_openfortivpn() {
    local p
    if p="$(command -v openfortivpn 2>/dev/null)" && [ -n "$p" ]; then
        printf '%s\n' "$p"; return 0
    fi
    for p in /opt/homebrew/bin/openfortivpn /usr/local/bin/openfortivpn \
             /usr/bin/openfortivpn /usr/sbin/openfortivpn; do
        if [ -x "$p" ]; then printf '%s\n' "$p"; return 0; fi
    done
    return 1
}

detect_openvpn() {
    local p
    if p="$(command -v openvpn 2>/dev/null)" && [ -n "$p" ]; then
        printf '%s\n' "$p"; return 0
    fi
    for p in /opt/homebrew/sbin/openvpn /usr/local/sbin/openvpn \
             /opt/homebrew/bin/openvpn /usr/local/bin/openvpn \
             /usr/sbin/openvpn /usr/bin/openvpn; do
        if [ -x "$p" ]; then printf '%s\n' "$p"; return 0; fi
    done
    return 1
}

resolve_secret_backend() {
    if [ "$SECRET_BACKEND" != "auto" ]; then
        case "$SECRET_BACKEND" in
            security) command -v security >/dev/null 2>&1 ;;
            secret-tool) command -v secret-tool >/dev/null 2>&1 ;;
            pass) command -v pass >/dev/null 2>&1 ;;
            *) return 1 ;;
        esac || return 1
        printf '%s\n' "$SECRET_BACKEND"
        return 0
    fi
    if [ "$OS" = "Darwin" ] && command -v security >/dev/null 2>&1; then
        echo security; return 0
    fi
    # secret-tool needs a running secret service (D-Bus session + keyring),
    # which headless servers lack — prefer it only when a session bus is
    # present, else fall back to pass (works headless). Last resort: whichever
    # exists. Override explicitly with SECRET_BACKEND in settings.
    if command -v secret-tool >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
        echo secret-tool; return 0
    fi
    if command -v pass        >/dev/null 2>&1; then echo pass;        return 0; fi
    if command -v secret-tool >/dev/null 2>&1; then echo secret-tool; return 0; fi
    return 1
}

# --- secret store abstraction ---------------------------------------------
# "kind" selects which secret under the same $SECRET_SERVICE: "password" (the
# default) or "otp" (the TOTP seed). Each is further scoped by the *active*
# $VPN_TYPE, so fortivpn and openvpn get fully independent password/OTP
# entries — this is what makes `switch` seamless (both backends' credentials
# can be stored at once, with nothing to re-enter) and, critically, is what
# stops an OTP seed configured for one backend from silently getting appended
# to the *other* backend's password after a switch (e.g. openvpn needs
# password+OTP, fortivpn here is password-only — without per-backend scoping,
# `secret_present otp` can't tell which backend it's answering for).
# secret_account_legacy is the pre-multi-backend, backend-agnostic account
# name; secret_get falls back to it so upgrading users don't lose an
# already-stored secret on first run (secret_set always (re)writes forward to
# the new per-backend account).
secret_account() {
    case "${1:-password}" in
        otp) printf '%s\n' "${USER}-${VPN_TYPE}-totp" ;;
        *)   printf '%s\n' "${USER}-${VPN_TYPE}" ;;
    esac
}

secret_account_legacy() {
    case "${1:-password}" in
        otp) printf '%s\n' "${USER}-totp" ;;
        *)   printf '%s\n' "$USER" ;;
    esac
}

_secret_get_account() {
    local account="$1"
    case "$SECRET_BACKEND_RESOLVED" in
        security)    security find-generic-password -a "$account" -s "$SECRET_SERVICE" -w 2>/dev/null ;;
        secret-tool) secret-tool lookup service "$SECRET_SERVICE" account "$account" 2>/dev/null ;;
        pass)        pass show "$SECRET_SERVICE/$account" 2>/dev/null | head -n 1 ;;
        *)           return 1 ;;
    esac
}

_secret_delete_account() {
    local account="$1"
    case "$SECRET_BACKEND_RESOLVED" in
        security)    security delete-generic-password -a "$account" -s "$SECRET_SERVICE" >/dev/null 2>&1 ;;
        secret-tool) secret-tool clear service "$SECRET_SERVICE" account "$account" >/dev/null 2>&1 ;;
        pass)        pass rm -f "$SECRET_SERVICE/$account" >/dev/null 2>&1 ;;
        *)           return 1 ;;
    esac
}

secret_get() {
    local kind="${1:-password}" account v
    account="$(secret_account "$kind")"
    if v="$(_secret_get_account "$account")" && [ -n "$v" ]; then
        printf '%s' "$v"; return 0
    fi
    # Fall back to the shared pre-multi-backend account.
    account="$(secret_account_legacy "$kind")"
    _secret_get_account "$account"
}

# Like secret_get, but reports which account actually served the value (the
# per-backend one, or the legacy fallback) — used by `doctor`/`set-*` output
# so it never claims a backend-scoped account is in use when a value is in
# fact still coming from the pre-multi-backend shared entry.
secret_which_account() {
    local kind="${1:-password}" account v
    account="$(secret_account "$kind")"
    if v="$(_secret_get_account "$account")" && [ -n "$v" ]; then
        printf '%s\n' "$account"; return 0
    fi
    account="$(secret_account_legacy "$kind")"
    if v="$(_secret_get_account "$account")" && [ -n "$v" ]; then
        printf '%s\n' "$account"; return 0
    fi
    return 1
}

secret_set() {
    local pw="$1" kind="${2:-password}" account
    account="$(secret_account "$kind")"
    case "$SECRET_BACKEND_RESOLVED" in
        security)
            # Pass the value with -w. (A bare -w makes `security` prompt on the
            # tty and ignore stdin, so piping the password doesn't work when a
            # terminal is attached.) The value is briefly visible in this single
            # `security` invocation's argv — a one-time, local, interactive
            # trade-off, unlike the per-connection exposure this design removes.
            security add-generic-password -U -a "$account" -s "$SECRET_SERVICE" -w "$pw" >/dev/null 2>&1 ;;
        secret-tool)
            printf '%s' "$pw" | secret-tool store --label="$SECRET_SERVICE ($VPN_TYPE $kind)" \
                service "$SECRET_SERVICE" account "$account" >/dev/null 2>&1 ;;
        pass)
            printf '%s\n' "$pw" | pass insert -m -f "$SECRET_SERVICE/$account" >/dev/null 2>&1 ;;
        *)  return 1 ;;
    esac
}

secret_delete() {
    local kind="${1:-password}" a_new a_legacy ok=1
    # Clear both the per-backend and legacy accounts, so a stale legacy entry
    # can't resurrect (via secret_get's fallback) after "removing" a secret.
    a_new="$(secret_account "$kind")"
    a_legacy="$(secret_account_legacy "$kind")"
    _secret_delete_account "$a_new"    && ok=0
    _secret_delete_account "$a_legacy" && ok=0
    return "$ok"
}

secret_present() {
    local kind="${1:-password}" v
    v="$(secret_get "$kind")" && [ -n "$v" ]
}

# Generates the current 6-digit TOTP code from the stored seed via `oathtool`.
# Called fresh on every launch attempt (codes rotate every 30s), never cached.
otp_now() {
    local seed
    seed="$(secret_get otp)" || return 1
    [ -n "$seed" ] || return 1
    if ! command -v oathtool >/dev/null 2>&1; then
        log "oathtool not found — install it to use OTP-appended passwords (brew install oath-toolkit / apt install oathtool)"
        return 1
    fi
    oathtool --totp -b "$seed" 2>/dev/null
}

# --- network abstraction ---------------------------------------------------
# Echoes "<iface> <ip>" for the first ppp interface that has an inet address.
# Scoped to ppp* so it ignores unrelated utun*/other VPNs (openfortivpn uses
# pppd → ppp0 on both macOS and Linux).
ppp_inet() {
    local out i ip
    if [ "$OS" = "Linux" ] && command -v ip >/dev/null 2>&1; then
        out="$(ip -o -4 addr show 2>/dev/null \
            | awk '$2 ~ /^ppp[0-9]/ {split($4,a,"/"); print $2, a[1]; exit}')"
        [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
        return 1
    fi
    for i in $(ifconfig -l 2>/dev/null); do
        case "$i" in
            ppp[0-9]*)
                ip="$(ifconfig "$i" 2>/dev/null | awk '/inet /{print $2; exit}')"
                [ -n "$ip" ] && { printf '%s %s\n' "$i" "$ip"; return 0; }
                ;;
        esac
    done
    return 1
}

# Interface that general internet traffic egresses on (for FULL vs SPLIT).
net_default_iface() {
    if [ "$OS" = "Linux" ] && command -v ip >/dev/null 2>&1; then
        ip route get 8.8.8.8 2>/dev/null \
            | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
        return
    fi
    route -n get 8.8.8.8 2>/dev/null | awk '/interface:/{print $2; exit}'
}

# Echoes "<iface> <ip>" for the openvpn tunnel interface. On Linux this is
# unambiguous (tun[0-9]*). On macOS, openvpn's own utun driver assigns a name
# dynamically, and utun* is also used by other things (other VPNs, Continuity,
# etc.), so this is best-effort unless TUN_IFACE pins an exact name.
tun_inet() {
    local out i ip
    if [ -n "$TUN_IFACE" ]; then
        if [ "$OS" = "Linux" ] && command -v ip >/dev/null 2>&1; then
            ip="$(ip -o -4 addr show dev "$TUN_IFACE" 2>/dev/null \
                | awk '{split($4,a,"/"); print a[1]; exit}')"
        else
            ip="$(ifconfig "$TUN_IFACE" 2>/dev/null | awk '/inet /{print $2; exit}')"
        fi
        [ -n "$ip" ] && { printf '%s %s\n' "$TUN_IFACE" "$ip"; return 0; }
        return 1
    fi
    if [ "$OS" = "Linux" ] && command -v ip >/dev/null 2>&1; then
        out="$(ip -o -4 addr show 2>/dev/null \
            | awk '$2 ~ /^tun[0-9]/ {split($4,a,"/"); print $2, a[1]; exit}')"
        [ -n "$out" ] && { printf '%s\n' "$out"; return 0; }
        return 1
    fi
    for i in $(ifconfig -l 2>/dev/null); do
        case "$i" in
            utun[0-9]*)
                ip="$(ifconfig "$i" 2>/dev/null | awk '/inet /{print $2; exit}')"
                [ -n "$ip" ] && { printf '%s %s\n' "$i" "$ip"; return 0; }
                ;;
        esac
    done
    return 1
}

# Dispatches to the interface probe for the active VPN_TYPE.
vpn_inet() {
    case "$VPN_TYPE" in
        openvpn) tun_inet ;;
        fortivpn) ppp_inet ;;
        *)       echo "Error: invalid VPN_TYPE '$VPN_TYPE'" >&2; return 1 ;;
    esac
}

file_size() {
    wc -c < "$1" 2>/dev/null | tr -d ' '
}

# True only if a NOPASSWD rule grants the EXACT command line in "$*".
# `sudo -n -l <cmd>` can't be used: it returns success for anything the user may
# run *with* a password (e.g. a blanket "(ALL) ALL"). The full `sudo -n -l`
# listing instead names NOPASSWD entries explicitly, and (under the default
# listpw=any) prints without a password whenever any NOPASSWD rule exists.
sudo_has_nopasswd() {
    local want="$*" escaped line spec
    escaped="$(sudoers_escape "$want")"
    while IFS= read -r line; do
        case "$line" in
            *NOPASSWD:*)
                spec="${line#*NOPASSWD:}"
                spec="${spec#"${spec%%[![:space:]]*}"}"
                spec="${spec%"${spec##*[![:space:]]}"}"
                # sudo -l may print the sudoers-escaped command spec. Compare
                # both forms, but require the complete listing line to match.
                if [ "$spec" = "$want" ] || [ "$spec" = "$escaped" ]; then
                    return 0
                fi
                ;;
        esac
    done < <(sudo -n -l 2>/dev/null)
    return 1
}

# True only if $1 is alive AND its command line contains our exact monitor
# token. This mitigates the classic pid-file race: a stale PID_FILE surviving
# an unclean exit/crash, later matching an unrelated process that the OS has
# since reused that same pid for — `kill -0` alone can't distinguish that case
# from the real monitor.
_pid_is_monitor() {
    local pid="$1" cmd expected_token
    expected_token="$MONITOR_TOKEN"
    if [ -z "$expected_token" ] && [ -f "$MONITOR_OWNER_FILE" ]; then
        expected_token="$(awk '{print $1}' "$MONITOR_OWNER_FILE" 2>/dev/null)"
    fi
    [ -n "$expected_token" ] || return 1
    cmd="$(ps -ww -o command= -p "$pid" 2>/dev/null)" ||
        cmd="$(ps -ww -o args= -p "$pid" 2>/dev/null)" || return 1
    # Match argument boundaries and the token recorded for this monitor start;
    # a command line merely mentioning "vpnctl __run__" is not sufficient.
    case " $cmd " in
        *" $SELF __run__ $expected_token "*) return 0 ;;
        *)                                             return 1 ;;
    esac
}

# Prints the monitor's pid and returns success only if it's actually alive
# *and* identified as our monitor process (see _pid_is_monitor).
monitor_pid() {
    [ -f "$PID_FILE" ] || return 1
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null)"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    if kill -0 "$pid" 2>/dev/null && _pid_is_monitor "$pid"; then
        printf '%s\n' "$pid"
        return 0
    fi
    return 1
}

tunnel_running() {
    # shellcheck disable=SC2086  # command is assembled from validated, space-free paths
    [ -n "$ACTIVE_STATUS_CMD" ] && sudo -n $ACTIVE_STATUS_CMD >/dev/null 2>&1
}

# Healthy = the VPN process is alive AND the tunnel interface has an IP.
vpn_healthy() {
    tunnel_running && vpn_inet >/dev/null 2>&1
}

rotate_log() {
    [ -f "$LOG_FILE" ] || return 0
    local size
    size="$(file_size "$LOG_FILE")"; [ -n "$size" ] || size=0
    if [ "$size" -gt "$MAX_LOG_BYTES" ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1"
    fi
}

require_config() {
    if [ ! -r "$ACTIVE_CONFIG" ]; then
        echo "Error: no readable $VPN_TYPE config at $ACTIVE_CONFIG" >&2
        echo "Run: $PROG setup" >&2
        return 1
    fi
}

_path_owner() {
    if [ "$OS" = "Darwin" ]; then
        stat -f '%Su' "$1" 2>/dev/null
    else
        stat -c '%U' "$1" 2>/dev/null
    fi
}

_path_mode() {
    if [ "$OS" = "Darwin" ]; then
        stat -f '%Lp' "$1" 2>/dev/null
    else
        stat -c '%a' "$1" 2>/dev/null
    fi
}

# A sudoers rule must never grant root execution from a path the invoking user
# can replace. Check the file and every parent directory, not only the leaf:
# a writable parent would allow replacing an otherwise root-owned config.
require_privileged_path() {
    local path="$1" current owner mode
    [ -e "$path" ] && [ ! -L "$path" ] || {
        echo "Error: privileged path must be a regular, non-symlink path: $path" >&2
        return 1
    }
    current="$path"
    while [ "$current" != "/" ] && [ -n "$current" ]; do
        owner="$(_path_owner "$current")"
        mode="$(_path_mode "$current")"
        if [ "$owner" != "root" ] || [ -z "$mode" ] || (( (8#$mode) & 18 )); then
            echo "Error: privileged path must be root-owned and not group/world-writable:" >&2
            echo "  $current (owner: ${owner:-unknown}, mode: ${mode:-unknown})" >&2
            echo "Move the VPN config and its parent directory under a root-owned path (for example /etc/vpncli), then retry." >&2
            return 1
        fi
        current="$(dirname "$current")"
    done
}

validate_config_security() {
    local config="$1"
    require_privileged_path "$config" || return 1
    if grep -nE '^[[:space:]]*(up|down|route-up|route-pre-down|ipchange|client-connect|client-disconnect|plugin|tls-verify|learn-address|auth-user-pass-verify|pppd-plugin|pppd-call)([[:space:]]|=)' "$config" \
        | grep -vE '^[^:]+:[[:space:]]*[#;]' >/dev/null 2>&1; then
        echo "Error: config contains an external script/plugin directive that is unsafe with root sudoers execution:" >&2
        grep -nE '^[[:space:]]*(up|down|route-up|route-pre-down|ipchange|client-connect|client-disconnect|plugin|tls-verify|learn-address|auth-user-pass-verify|pppd-plugin|pppd-call)([[:space:]]|=)' "$config" >&2
        echo "Remove the directive or use a privileged, root-owned wrapper with an explicit allowlist." >&2
        return 1
    fi
}

load_credentials() {
    local pw otp
    if ! pw="$(secret_get password)" || [ -z "$pw" ]; then
        log "Failed to retrieve a usable VPN password from the secret store ($SECRET_BACKEND_RESOLVED:$SECRET_SERVICE)"
        return 1
    fi
    # If a TOTP seed is stored, append a freshly generated 6-digit code to the
    # password (e.g. RADIUS/2FA gateways that want password+OTP concatenated).
    # Generated here — i.e. right before every launch, not once at monitor
    # start — since codes rotate every 30s and a reconnect can happen much
    # later than startup.
    if secret_present otp; then
        if ! otp="$(otp_now)" || [ -z "$otp" ]; then
            log "Failed to generate a TOTP code (check 'oathtool' is installed and the stored secret is valid)"
            return 1
        fi
        pw="${pw}${OTP_SEPARATOR}${otp}"
    fi
    # Exported so fortiVPN.expect reads it from the environment, never argv,
    # keeping it out of `ps`. Also used directly for the openvpn auth file.
    export VPN_PASSWORD="$pw"
}

launch_tunnel() {
    if ! load_credentials; then
        log "Skipping launch: no usable credentials"
        return 1
    fi
    case "$VPN_TYPE" in
        openvpn) launch_openvpn ;;
        fortivpn) launch_fortivpn ;;
        *)        log "Invalid VPN_TYPE '$VPN_TYPE'; refusing to launch"; return 1 ;;
    esac
}

launch_fortivpn() {
    # shellcheck disable=SC2024  # redirect applies to the backgrounded helper job
    printf '%s\n' "$VPN_PASSWORD" | sudo -n "$VPNCTL_HELPER" start-fortivpn \
        "$EXPECT_SCRIPT" "$OPENFORTIVPN" "$CONFIG_PATH" "$TUNNEL_PID_FILE" >> "$LOG_FILE" 2>&1 &
    TUNNEL_PID=$!
    log "Launched fortivpn tunnel (expect pid $TUNNEL_PID)"
}

launch_openvpn() {
    # Fresh auth-user-pass file each launch: username then password, owner-only.
    # Kept out of argv (never in `ps`) and at a fixed path so it can be named
    # exactly in the generated sudoers rule.
    : > "$OPENVPN_AUTH_FILE"
    chmod 600 "$OPENVPN_AUTH_FILE" 2>/dev/null
    { printf '%s\n' "$OPENVPN_USERNAME"; printf '%s\n' "$VPN_PASSWORD"; } > "$OPENVPN_AUTH_FILE"
    # shellcheck disable=SC2024  # redirect applies to this whole backgrounded
    # job (bash), not to sudo's own stdout — sudo runs fine as the privileged
    # child writing to the fd bash already opened before the fork.
    sudo -n "$VPNCTL_HELPER" start-openvpn "$OPENVPN" "$OPENVPN_CONFIG_PATH" \
        "$OPENVPN_AUTH_FILE" "$TUNNEL_PID_FILE" \
        >> "$LOG_FILE" 2>&1 &
    TUNNEL_PID=$!
    log "Launched openvpn tunnel (pid $TUNNEL_PID)"
}

# Used by the backgrounded monitor: never prompts (sudo -n), so it can't hang.
teardown_tunnel() {
    TUNNEL_PID=""
    sudo -n "$VPNCTL_HELPER" stop "$ACTIVE_BIN" "$ACTIVE_CONFIG" \
        "$TUNNEL_PID_FILE" 2>/dev/null || true
}

write_monitor_state() {
    local path="$1" value="$2" tmp
    tmp="${path}.$$"
    printf '%s\n' "$value" > "$tmp" && mv -f "$tmp" "$path"
}

monitor_lock_owned() {
    [ -n "$MONITOR_TOKEN" ] &&
        [ -f "$MONITOR_OWNER_FILE" ] &&
        [ "$(awk '{print $1}' "$MONITOR_OWNER_FILE" 2>/dev/null)" = "$MONITOR_TOKEN" ]
}

cleanup_monitor_state() {
    monitor_lock_owned || return 0
    rm -f "$PID_FILE" "$MONITOR_READY_FILE" "$MONITOR_OWNER_FILE"
    rmdir "$MONITOR_LOCK_DIR" 2>/dev/null || true
}

monitor_lock_is_stale() {
    [ -d "$MONITOR_LOCK_DIR" ] || return 1
    local owner_pid started now
    read -r _ owner_pid started < "$MONITOR_OWNER_FILE" 2>/dev/null || return 0
    [[ "$owner_pid" =~ ^[0-9]+$ && "$started" =~ ^[0-9]+$ ]] || return 0
    now="$(date +%s)"
    [ "$now" -ge "$started" ] && [ $((now - started)) -ge "$STARTUP_TIMEOUT" ] || return 1
    # Once the startup window has elapsed, trust the monitor PID identity rather
    # than the launcher's PID, which may have been reused by another process.
    monitor_pid && return 1
    return 0
}

acquire_monitor_lock() {
    mkdir -p "$STATE_DIR" || return 1
    if mkdir "$MONITOR_LOCK_DIR" 2>/dev/null; then
        MONITOR_TOKEN="$(date +%s)-$$-$RANDOM"
        write_monitor_state "$MONITOR_OWNER_FILE" "$MONITOR_TOKEN $$ $(date +%s)"
        return 0
    fi
    if monitor_pid; then
        return 2
    fi
    if monitor_lock_is_stale; then
        log "Recovering stale monitor state"
        sudo -n "$VPNCTL_HELPER" stop "$TUNNEL_PID_FILE" 2>/dev/null || true
        rm -f "$PID_FILE" "$MONITOR_READY_FILE"
        rm -f "$MONITOR_OWNER_FILE"
        rmdir "$MONITOR_LOCK_DIR" 2>/dev/null || return 1
        acquire_monitor_lock
        return $?
    fi
    return 2
}

wait_for_monitor_ready() {
    local token="$1" pid="$2" elapsed=0 state
    while [ "$elapsed" -lt "$STARTUP_TIMEOUT" ]; do
        if [ -f "$MONITOR_READY_FILE" ]; then
            read -r state _ ready_pid < "$MONITOR_READY_FILE" 2>/dev/null || true
            if [ "$state" = "$token" ] && [ "$ready_pid" = "$pid" ]; then
                return 0
            fi
        fi
        if ! kill -0 "$pid" 2>/dev/null; then
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 1
}

# ===========================================================================
# Monitor daemon
# ===========================================================================
run_monitor() {
    MONITOR_TOKEN="${2:-}"
    if [ -z "$MONITOR_TOKEN" ] || ! monitor_lock_owned; then
        log "Exiting: monitor startup lock is not owned"
        return 1
    fi
    trap 'exit 0' TERM INT
    trap 'teardown_tunnel; cleanup_monitor_state' EXIT
    write_monitor_state "$MONITOR_OWNER_FILE" "$MONITOR_TOKEN $$ $(date +%s)"
    printf '%s\n' "$$" > "$PID_FILE"

    if [ -z "$ACTIVE_BIN" ]; then
        log "Exiting: $VPN_TYPE binary not found"; return 1
    fi
    if [ "$VPN_TYPE" = "openvpn" ] && [ -z "$OPENVPN_USERNAME" ]; then
        log "Exiting: OPENVPN_USERNAME not set"; return 1
    fi
    if ! secret_present password; then
        log "Exiting: no VPN password in the secret store ($SECRET_BACKEND_RESOLVED:$SECRET_SERVICE)"
        return 1
    fi
    write_monitor_state "$MONITOR_READY_FILE" "$MONITOR_TOKEN ready $$"
    log "Monitor ready (pid $$)"

    local streak=0
    while true; do
        rotate_log
        if vpn_healthy; then
            streak=0
        elif ! tunnel_running; then
            log "Tunnel down (no process) — connecting"
            teardown_tunnel
            launch_tunnel
            streak=0
            sleep "$CONNECT_GRACE"
        else
            # Process alive but no tunnel interface: still connecting or half-open.
            streak=$((streak + 1))
            if [ "$streak" -ge "$HALF_OPEN_CHECKS" ]; then
                log "Tunnel half-open ($streak checks, no tunnel interface) — reconnecting"
                teardown_tunnel
                launch_tunnel
                streak=0
                sleep "$CONNECT_GRACE"
            fi
        fi
        sleep "$INTERVAL"
    done
}

# ===========================================================================
# Subcommands
# ===========================================================================
do_start() {
    local pid newpid token
    if pid="$(monitor_pid)"; then
        echo "Already running (monitor pid $pid)"
        return 0
    fi
    require_config || return 1
    if [ -z "$ACTIVE_BIN" ]; then
        local var_name="OPENFORTIVPN"
        [ "$VPN_TYPE" = "openvpn" ] && var_name="OPENVPN"
        echo "Error: $VPN_TYPE binary not found. Install it, or set $var_name in $SETTINGS_FILE." >&2
        return 1
    fi
    if [ "$VPN_TYPE" = "fortivpn" ] && [ -z "$EXPECT_SCRIPT" ]; then
        echo "Error: fortiVPN.expect helper not found near $SCRIPT_DIR." >&2
        return 1
    fi
    if [ "$VPN_TYPE" = "openvpn" ] && [ -z "$OPENVPN_USERNAME" ]; then
        echo "Error: OPENVPN_USERNAME not set. Set it in $SETTINGS_FILE (or re-run: $PROG setup)." >&2
        return 1
    fi
    if ! sudo_has_nopasswd "$ACTIVE_LAUNCH_CMD"; then
        echo "Error: passwordless sudo is not configured for this exact command." >&2
        echo "Run: $PROG install-sudoers   (or: $PROG setup)" >&2
        return 1
    fi

    acquire_monitor_lock
    case "$?" in
        0) ;;
        2)
            echo "Already running or starting" >&2
            return 0
            ;;
        *)
            echo "Error: could not acquire monitor startup lock" >&2
            return 1
            ;;
    esac
    token="$MONITOR_TOKEN"
    rotate_log
    mkdir -p "$STATE_DIR"
    nohup "$SELF" __run__ "$token" >> "$LOG_FILE" 2>&1 &
    newpid=$!
    disown 2>/dev/null || true
    if ! wait_for_monitor_ready "$token" "$newpid"; then
        echo "Error: monitor failed to become ready; see $LOG_FILE" >&2
        if kill -0 "$newpid" 2>/dev/null; then
            kill "$newpid" 2>/dev/null || true
        fi
        return 1
    fi
    log "Monitor started (pid $newpid)"
    echo "Started (monitor pid $newpid)"
}

do_stop() {
    local pid
    if pid="$(monitor_pid)"; then
        kill "$pid" 2>/dev/null    # monitor's trap tears the tunnel down
        log "Monitor stopped (pid $pid)"
        echo "Monitor stopped (pid $pid)"
        sleep 1                    # give the trap a moment to run
    else
        echo "Monitor was not running"
    fi
    rm -f "$PID_FILE"

    # Fallback in case the monitor died uncleanly and left the tunnel up.
    if tunnel_running; then
        echo "Tearing down tunnel (may prompt for sudo password)..."
        sudo "$VPNCTL_HELPER" stop "$ACTIVE_BIN" "$ACTIVE_CONFIG" \
            "$TUNNEL_PID_FILE" 2>/dev/null
    fi
}

do_restart() {
    do_stop
    sleep 1
    do_start
}

# Switches VPN_TYPE at runtime and persists it to $SETTINGS_FILE, without the
# full `setup` wizard. This is only "seamless" (no re-prompting, no sudo
# password) when the target backend has already been fully provisioned once
# (config file, password [+ optional OTP seed], and its own sudoers rule —
# all of which are backend-scoped, see secret_account()/ACTIVE_SUDOERS_PATH),
# e.g. via `setup` or `set-password`/`set-otp-secret`/`install-sudoers` run at
# least once while that backend was active. Otherwise it tells you exactly
# what's still missing instead of silently failing.
do_switch() {
    local target="${1:-}" was_running="" ready=1 var_name
    case "$target" in
        fortivpn|openvpn) ;;
        "")
            echo "Usage: $PROG switch <fortivpn|openvpn>" >&2
            echo "Currently: $VPN_TYPE" >&2
            return 1 ;;
        *)
            echo "Error: unknown backend '$target' (expected 'fortivpn' or 'openvpn')" >&2
            return 1 ;;
    esac

    if [ "$target" = "$VPN_TYPE" ]; then
        echo "Already using $VPN_TYPE."
        return 0
    fi

    if was_running="$(monitor_pid)"; then
        echo "Stopping $VPN_TYPE monitor before switching..."
        do_stop
    fi

    settings_set VPN_TYPE "$target"
    VPN_TYPE="$target"
    resolve_active_backend
    echo "Switched backend: $VPN_TYPE"
    echo

    # Readiness check scoped to what launching $VPN_TYPE actually needs — every
    # one of these is independent per backend, so this never depends on how the
    # *other* backend is configured.
    if [ -z "$ACTIVE_BIN" ]; then
        var_name="OPENFORTIVPN"; [ "$VPN_TYPE" = "openvpn" ] && var_name="OPENVPN"
        echo "  [FAIL] $VPN_TYPE binary not found — install it or set $var_name in $SETTINGS_FILE" >&2
        ready=0
    fi
    if [ ! -r "$ACTIVE_CONFIG" ]; then
        echo "  [FAIL] no config at $ACTIVE_CONFIG — run: $PROG setup" >&2
        ready=0
    fi
    if [ "$VPN_TYPE" = "openvpn" ] && [ -z "$OPENVPN_USERNAME" ]; then
        echo "  [FAIL] OPENVPN_USERNAME not set — run: $PROG setup" >&2
        ready=0
    fi
    if ! secret_present password; then
        echo "  [FAIL] no $VPN_TYPE password stored (account: $(secret_account password)) — run: $PROG set-password" >&2
        ready=0
    fi
    if ! sudo_has_nopasswd "$ACTIVE_LAUNCH_CMD"; then
        echo "  [FAIL] passwordless sudo not configured for $VPN_TYPE — run: $PROG install-sudoers" >&2
        ready=0
    fi

    if [ "$ready" -eq 1 ]; then
        echo "$VPN_TYPE is fully configured."
        if [ -n "$was_running" ]; then
            do_start
        else
            echo "Run: $PROG start"
        fi
    else
        echo
        echo "Fix the [FAIL] item(s) above, then: $PROG doctor   (or: $PROG start)"
        return 1
    fi
}

do_status() {
    local pid inet
    if pid="$(monitor_pid)"; then
        echo "Monitor: running (pid $pid)"
    else
        echo "Monitor: stopped"
    fi

    if inet="$(vpn_inet)"; then
        echo "Tunnel:  connected ($inet) [$VPN_TYPE]"
    elif tunnel_running; then
        echo "Tunnel:  connecting (process up, no tunnel interface yet) [$VPN_TYPE]"
    else
        echo "Tunnel:  disconnected [$VPN_TYPE]"
    fi
}

do_routes() {
    local inet iface def_if count
    if ! inet="$(vpn_inet)"; then
        echo "Tunnel: disconnected — no tunnel interface is up, so there are no VPN routes."
        return 1
    fi
    iface="${inet%% *}"

    def_if="$(net_default_iface)"
    if [ "$def_if" = "$iface" ]; then
        echo "Mode:   FULL tunnel — all traffic routes through the VPN ($iface)"
    else
        echo "Mode:   SPLIT tunnel — only the networks below use the VPN ($iface)"
        echo "        General internet egresses via ${def_if:-unknown}"
    fi

    if [ "$OS" = "Linux" ] && command -v ip >/dev/null 2>&1; then
        count="$(ip route show dev "$iface" 2>/dev/null | wc -l | tr -d ' ')"
        echo "Routes: $count via $iface"
        echo
        ip route show dev "$iface" 2>/dev/null | sed 's/^/  /'
    else
        count="$(netstat -rn -f inet 2>/dev/null | awk -v ifc="$iface" '$NF==ifc' | wc -l | tr -d ' ')"
        echo "Routes: $count via $iface"
        echo
        printf '  %-22s %-18s %s\n' "DESTINATION" "GATEWAY" "FLAGS"
        printf '  %-22s %-18s %s\n' "-----------" "-------" "-----"
        netstat -rn -f inet 2>/dev/null | awk -v ifc="$iface" '$NF==ifc {printf "  %-22s %-18s %s\n", $1, $2, $3}'
    fi
}

do_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        echo "No log file yet at $LOG_FILE"
        return 1
    fi
    if [ "${1:-}" = "-f" ] || [ "${1:-}" = "--follow" ]; then
        echo "Tailing $LOG_FILE (Ctrl-C to stop)..."
        tail -n 50 -f "$LOG_FILE"
    else
        tail -n 50 "$LOG_FILE"
    fi
}

_DOCTOR_FAIL=0
report() {
    case "$1" in
        ok)   echo "  [ ok ] $2" ;;
        warn) echo "  [warn] $2" ;;
        fail) echo "  [FAIL] $2"; _DOCTOR_FAIL=1 ;;
        info) echo "  [info] $2" ;;
    esac
}

do_doctor() {
    _DOCTOR_FAIL=0
    local pid inet
    echo "vpnctl diagnostics:"
    echo
    report info "OS: $OS    user: $USER"
    report info "backend: $VPN_TYPE   (set VPN_TYPE=fortivpn|openvpn in $SETTINGS_FILE)"
    report info "config dir: $CONFIG_DIR"
    report info "state dir:  $STATE_DIR"
    echo

    if [ "$VPN_TYPE" = "openvpn" ]; then
        if [ -n "$OPENVPN" ] && [ -x "$OPENVPN" ]; then
            report ok "openvpn found ($OPENVPN)"
        else
            report fail "openvpn not found — install it (brew/apt) or set OPENVPN in $SETTINGS_FILE"
        fi

        if [ -r "$OPENVPN_CONFIG_PATH" ]; then
            if grep -qE '^[[:space:]]*(client|remote)[[:space:]]' "$OPENVPN_CONFIG_PATH"; then
                report ok "config readable with client/remote directives ($OPENVPN_CONFIG_PATH)"
            else
                report fail "config $OPENVPN_CONFIG_PATH is missing 'client'/'remote' directives"
            fi
        else
            report fail "no config at $OPENVPN_CONFIG_PATH — run: $PROG setup"
        fi

        if [ -n "$OPENVPN_USERNAME" ]; then
            report ok "OPENVPN_USERNAME set ($OPENVPN_USERNAME)"
        else
            report fail "OPENVPN_USERNAME not set — set it in $SETTINGS_FILE (or run: $PROG setup)"
        fi

        if [ "$OS" = "Darwin" ]; then
            if [ -n "$TUN_IFACE" ]; then
                report ok "TUN_IFACE pinned ($TUN_IFACE) — unambiguous tunnel-health detection"
            else
                report warn "TUN_IFACE not set on macOS — health checks fall back to the first addressed utun*, which other VPNs/services can also use and may be misreported as this tunnel; set TUN_IFACE=utunN in $SETTINGS_FILE once you know which interface openvpn uses (see 'vpnctl logs' after connecting)"
            fi
        fi
    else
        if [ -n "$OPENFORTIVPN" ] && [ -x "$OPENFORTIVPN" ]; then
            report ok "openfortivpn found ($OPENFORTIVPN)"
        else
            report fail "openfortivpn not found — install it (brew/apt) or set OPENFORTIVPN in $SETTINGS_FILE"
        fi

        if [ -n "$EXPECT_SCRIPT" ] && [ -x "$EXPECT_SCRIPT" ]; then
            report ok "expect helper present ($EXPECT_SCRIPT)"
        elif [ -n "$EXPECT_SCRIPT" ]; then
            report fail "expect helper present but not executable: $EXPECT_SCRIPT"
        else
            report fail "expect helper not found near $SCRIPT_DIR"
        fi

        if command -v expect >/dev/null 2>&1; then
            report ok "'expect' interpreter installed"
        else
            report fail "'expect' interpreter missing — install it (brew install expect / apt install expect)"
        fi

        if [ -r "$CONFIG_PATH" ]; then
            if grep -q '^[[:space:]]*host' "$CONFIG_PATH" && grep -q '^[[:space:]]*trusted-cert' "$CONFIG_PATH"; then
                if grep -q 'REPLACE_WITH_GATEWAY_CERT_SHA256' "$CONFIG_PATH"; then
                    report warn "config present but trusted-cert is still the placeholder ($CONFIG_PATH)"
                else
                    report ok "config readable with host + trusted-cert ($CONFIG_PATH)"
                fi
            else
                report fail "config $CONFIG_PATH is missing a host or trusted-cert line"
            fi
        else
            report fail "no config at $CONFIG_PATH — run: $PROG setup"
        fi
    fi

    if [ -z "$SECRET_BACKEND_RESOLVED" ]; then
        report fail "no secret backend available — need 'security' (macOS), 'secret-tool', or 'pass'"
    elif secret_present password; then
        report ok "VPN password stored (backend: $SECRET_BACKEND_RESOLVED, account: $(secret_which_account password))"
    else
        report fail "no $VPN_TYPE password in $SECRET_BACKEND_RESOLVED (account: $(secret_account password)) — run: $PROG set-password"
    fi

    if secret_present otp; then
        if command -v oathtool >/dev/null 2>&1; then
            report ok "TOTP secret stored for $VPN_TYPE (account: $(secret_which_account otp)) — a fresh 6-digit code is appended to the password each connect"
        else
            report fail "TOTP secret stored but 'oathtool' is missing — install it (brew install oath-toolkit / apt install oathtool)"
        fi
    else
        report info "no TOTP secret configured for $VPN_TYPE (only needed for password+OTP gateways — set with: $PROG set-otp-secret). Backends are scoped independently, so this is unaffected by any OTP secret stored for the other backend."
    fi

    if [ -n "$ACTIVE_BIN" ] && sudo_has_nopasswd "$ACTIVE_LAUNCH_CMD"; then
        report ok "passwordless sudo for the $VPN_TYPE launch command (rule: $ACTIVE_SUDOERS_PATH)"
    else
        report fail "passwordless sudo for $VPN_TYPE missing/mismatched — run: $PROG install-sudoers"
    fi

    if sudo_has_nopasswd "$ACTIVE_STATUS_CMD" && sudo_has_nopasswd "$ACTIVE_STOP_CMD"; then
        report ok "passwordless sudo for tunnel status and teardown (helper)"
    else
        report fail "passwordless sudo for tunnel status/teardown missing — run: $PROG install-sudoers"
    fi

    echo
    if pid="$(monitor_pid)"; then
        report info "monitor running (pid $pid)"
    else
        report info "monitor not running"
    fi
    if inet="$(vpn_inet)"; then
        report info "tunnel connected ($inet)"
    elif tunnel_running; then
        report info "tunnel connecting (process up, no tunnel interface yet)"
    else
        report info "tunnel disconnected"
    fi

    echo
    if [ "$_DOCTOR_FAIL" -ne 0 ]; then
        echo "Result: problems found — see the [FAIL] lines above."
        return 1
    fi
    echo "Result: all checks passed."
    return 0
}

do_set_password() {
    local p1 p2 tries
    if [ -z "$SECRET_BACKEND_RESOLVED" ]; then
        echo "Error: no secret backend available (need 'security', 'secret-tool', or 'pass')." >&2
        return 1
    fi
    echo "Storing password for backend: $VPN_TYPE (independent of any other backend's password)."
    tries=0
    while :; do
        tries=$((tries + 1))
        printf 'Enter VPN password: '
        read -rs p1; echo
        printf 'Confirm VPN password: '
        read -rs p2; echo
        if [ -z "$p1" ]; then
            echo "Empty password." >&2
        elif [ "$p1" != "$p2" ]; then
            echo "Passwords do not match." >&2
        else
            break
        fi
        if [ "$tries" -ge 3 ]; then
            echo "Aborted after 3 attempts." >&2; return 1
        fi
        echo "Try again." >&2
    done

    if secret_set "$p1"; then
        echo "Stored VPN password for $VPN_TYPE (backend: $SECRET_BACKEND_RESOLVED, account: $(secret_account password))."
        echo "Verify with: $PROG doctor"
    else
        echo "Failed to store password in the secret store." >&2; return 1
    fi
}

do_set_otp_secret() {
    local seed tries
    if [ -z "$SECRET_BACKEND_RESOLVED" ]; then
        echo "Error: no secret backend available (need 'security', 'secret-tool', or 'pass')." >&2
        return 1
    fi
    echo "Enter the TOTP *secret/seed* — the base32 string from your authenticator"
    echo "enrollment (often labeled 'secret key', shown next to the QR code)."
    echo "This is NOT a 6-digit code; it's the long string used to generate them."
    echo "Once stored, vpnctl appends a freshly generated 6-digit code to your"
    echo "password on every connection attempt automatically."
    echo "Scoped to backend: $VPN_TYPE only — the other backend is unaffected."
    echo
    tries=0
    while :; do
        tries=$((tries + 1))
        printf 'TOTP secret (blank to cancel): '
        read -rs seed; echo
        if [ -z "$seed" ]; then
            echo "Cancelled."; return 1
        fi
        # base32 secrets are commonly copy-pasted with spaces; strip them.
        seed="$(printf '%s' "$seed" | tr -d '[:space:]')"
        if command -v oathtool >/dev/null 2>&1 && ! oathtool --totp -b "$seed" >/dev/null 2>&1; then
            echo "That doesn't look like a valid base32 TOTP secret." >&2
        else
            break
        fi
        if [ "$tries" -ge 3 ]; then
            echo "Aborted after 3 attempts." >&2; return 1
        fi
        echo "Try again." >&2
    done

    if secret_set "$seed" otp; then
        echo "Stored TOTP secret for $VPN_TYPE (backend: $SECRET_BACKEND_RESOLVED, account: $(secret_account otp))."
        echo "Verify with: $PROG doctor"
    else
        echo "Failed to store TOTP secret in the secret store." >&2; return 1
    fi
}

do_unset_otp_secret() {
    if ! secret_present otp; then
        echo "No TOTP secret is stored."
        return 0
    fi
    if secret_delete otp; then
        echo "Removed TOTP secret. Passwords will no longer get a code appended."
    else
        echo "Failed to remove TOTP secret." >&2; return 1
    fi
}

# Set/replace a "key = value" line in a file (append if absent). Pure-bash
# rewrite (no sed/awk), so values containing &, |, \, etc. stay literal
# instead of being interpreted as replacement syntax or a delimiter.
file_kv_set() {
    local file="$1" key="$2" val="$3" tmp line found=0
    tmp="$(mktemp "${TMPDIR:-/tmp}/vpncli.kv.XXXXXX")" || return 1
    if [ -f "$file" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            if [ "$found" -eq 0 ] && [[ "$line" =~ ^[[:space:]]*"$key"[[:space:]]*= ]]; then
                printf '%s = %s\n' "$key" "$val"
                found=1
            else
                printf '%s\n' "$line"
            fi
        done < "$file" > "$tmp"
    fi
    if [ "$found" -eq 0 ]; then
        printf '%s = %s\n' "$key" "$val" >> "$tmp"
    fi
    if [ -w "$(dirname "$file")" ] && { [ ! -e "$file" ] || [ -w "$file" ]; }; then
        mv "$tmp" "$file"
    else
        sudo install -o root -m 600 "$tmp" "$file"
        rm -f "$tmp"
    fi
}

conf_set() {
    file_kv_set "$CONFIG_PATH" "$1" "$2"
}

# Set/replace a shell-style "KEY=value" assignment in $SETTINGS_FILE (append if
# absent). Used to persist non-secret, per-machine tunables like VPN_TYPE and
# OPENVPN_USERNAME outside of code, same as every other setting.
settings_set() {
    local key="$1" val="$2" tmp line found=0
    mkdir -p "$CONFIG_DIR" 2>/dev/null
    tmp="$(mktemp "${TMPDIR:-/tmp}/vpncli.settings.XXXXXX")" || return 1
    if [ -f "$SETTINGS_FILE" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            if [ "$found" -eq 0 ] && [[ "$line" =~ ^[[:space:]]*"$key"= ]]; then
                printf '%s=%q\n' "$key" "$val"
                found=1
            else
                printf '%s\n' "$line"
            fi
        done < "$SETTINGS_FILE" > "$tmp"
    fi
    if [ "$found" -eq 0 ]; then
        printf '%s=%q\n' "$key" "$val" >> "$tmp"
    fi
    if [ -w "$CONFIG_DIR" ] && { [ ! -e "$SETTINGS_FILE" ] || [ -w "$SETTINGS_FILE" ]; }; then
        mv "$tmp" "$SETTINGS_FILE"
        chmod 600 "$SETTINGS_FILE" 2>/dev/null
    else
        sudo install -o root -m 600 "$tmp" "$SETTINGS_FILE"
        rm -f "$tmp"
    fi
}

# Escapes characters that are special inside a sudoers command spec: `*?[]`
# are shell-style wildcards there (so a literal path/user containing one of
# them would silently become a glob, potentially matching more than the exact
# command that was rendered — the sudoers docs require backslash-escaping
# them), and `,:=\` are argument/entry separators. Whitespace is rejected
# outright by the caller rather than escaped, since a literal space would
# still change how sudoers tokenizes the command's argument list.
sudoers_escape() {
    local s="$1" out="" ch i
    for (( i = 0; i < ${#s}; i++ )); do
        ch="${s:i:1}"
        case "$ch" in
            "\\"|","|":"|"="|"*"|"?"|"["|"]") out+="\\$ch" ;;
            *)                                out+="$ch" ;;
        esac
    done
    printf '%s' "$out"
}

# Pure-bash placeholder substitution for the sudoers templates — deliberately
# NOT `sed`: sed substitution needs a delimiter and treats `&`/backslash in
# the replacement specially, so a path/user containing the delimiter char
# (originally `|`) or those metacharacters could silently corrupt the
# generated rule instead of erroring. `${line//pat/repl}` is a literal
# substring replace (no regex, no delimiter), so any character is safe here;
# `sudoers_escape` (above) separately guards against sudoers' OWN wildcard
# syntax in the final file. Each extra arg is a "PLACEHOLDER=value" pair.
render_template() {
    local tmpl="$1"; shift
    local line pair key val
    while IFS= read -r line || [ -n "$line" ]; do
        for pair in "$@"; do
            key="${pair%%=*}"
            val="${pair#*=}"
            line="${line//$key/$val}"
        done
        printf '%s\n' "$line"
    done < "$tmpl"
}

prompt_config() {
    local host port user
    echo "Enter your VPN gateway details (blank = keep template value):"
    printf '  Host (e.g. vpn.example.com): '; read -r host
    printf '  Port [443]: '; read -r port
    printf '  Username: '; read -r user
    [ -n "$host" ] && conf_set host "$host"
    [ -n "$port" ] && conf_set port "$port"
    [ -n "$user" ] && conf_set username "$user"
    echo
    echo "trusted-cert: connect once; openfortivpn prints the gateway's SHA-256 to trust."
    echo "Paste it into the 'trusted-cert =' line of $CONFIG_PATH before connecting."
}

prompt_openvpn_config() {
    local user
    echo "Replace $OPENVPN_CONFIG_PATH with your provider's .ovpn client config"
    echo "(certs/keys embedded inline, or as absolute paths — it runs as root)."
    printf '  Username (auth-user-pass): '; read -r user
    if [ -n "$user" ]; then
        settings_set OPENVPN_USERNAME "$user"
        OPENVPN_USERNAME="$user"
    fi
    if [ "$OS" = "Darwin" ] && [ -z "$TUN_IFACE" ]; then
        echo
        echo "Note: on macOS, openvpn's utun interface name is assigned dynamically and"
        echo "isn't unique to this tool, so health checks are best-effort until pinned."
        echo "After your first successful connect, run 'vpnctl status' or check"
        echo "'vpnctl logs'/'ifconfig' for the utun name it used, then set:"
        echo "  TUN_IFACE=utunN   in $SETTINGS_FILE"
        echo "('vpnctl doctor' will keep warning about this until TUN_IFACE is set.)"
    fi
}

repair_secret_backend() {
    local ans
    case "${SECRET_BACKEND:-}" in
        auto|security|secret-tool|pass)
            SECRET_BACKEND_RESOLVED="$(resolve_secret_backend || true)"
            return 0
            ;;
    esac

    echo "Invalid SECRET_BACKEND in $SETTINGS_FILE: ${SECRET_BACKEND:-unset}"
    echo "Choose a supported secret backend to continue setup:"
    printf '  [1] auto (recommended)  [2] security  [3] secret-tool  [4] pass  [Enter = auto] '
    read -r ans
    case "$ans" in
        2) SECRET_BACKEND="security" ;;
        3) SECRET_BACKEND="secret-tool" ;;
        4) SECRET_BACKEND="pass" ;;
        *) SECRET_BACKEND="auto" ;;
    esac
    settings_set SECRET_BACKEND "$SECRET_BACKEND" || return 1
    SECRET_BACKEND_RESOLVED="$(resolve_secret_backend || true)"
}

install_privileged_assets() {
    local asset_dir="/usr/local/libexec/vpncli" target
    [ -n "$VPNCTL_HELPER" ] || {
        echo "Error: vpnctl-helper was not found near $SCRIPT_DIR." >&2
        return 1
    }
    [ -n "$ACTIVE_BIN" ] || return 0

    echo "Installing root-owned VPN runtime files (requires sudo)..."
    sudo install -d -o root -m 755 "$asset_dir"
    target="$asset_dir/$(basename "$ACTIVE_BIN")"
    sudo install -o root -m 755 "$ACTIVE_BIN" "$target"
    ACTIVE_BIN="$target"
    case "$VPN_TYPE" in
        openvpn) OPENVPN="$target" ;;
        *)       OPENFORTIVPN="$target" ;;
    esac
    settings_set "$([ "$VPN_TYPE" = "openvpn" ] && echo OPENVPN || echo OPENFORTIVPN)" "$target"

    target="$asset_dir/vpnctl-helper"
    sudo install -o root -m 755 "$VPNCTL_HELPER" "$target"
    VPNCTL_HELPER="$target"
    settings_set VPNCTL_HELPER "$target"

    if [ "$VPN_TYPE" = "fortivpn" ] && [ -n "$EXPECT_SCRIPT" ]; then
        target="$asset_dir/fortiVPN.expect"
        sudo install -o root -m 755 "$EXPECT_SCRIPT" "$target"
        EXPECT_SCRIPT="$target"
        settings_set EXPECT_SCRIPT "$target"
    fi
    resolve_active_backend
}

move_config_to_privileged_dir() {
    local source_dir="$CONFIG_DIR" target_dir="/etc/vpncli" file
    case "$source_dir" in
        "$HOME"/*) ;;
        *) return 0 ;;
    esac

    echo "Moving VPN configuration to $target_dir (requires sudo)..."
    sudo install -d -o root -m 755 "$target_dir"
    for file in vpn.conf vpn.ovpn settings; do
        if [ -f "$source_dir/$file" ]; then
            sudo install -o root -m 644 "$source_dir/$file" "$target_dir/$file"
        fi
    done
    CONFIG_DIR="$target_dir"
    CONFIG_PATH="$CONFIG_DIR/vpn.conf"
    SETTINGS_FILE="$CONFIG_DIR/settings"
    OPENVPN_CONFIG_PATH="$CONFIG_DIR/vpn.ovpn"
}

do_install_sudoers() {
    local tmpl tmp _p
    if [ -z "$ACTIVE_BIN" ]; then
        local var_name="OPENFORTIVPN"
        [ "$VPN_TYPE" = "openvpn" ] && var_name="OPENVPN"
        echo "Error: $VPN_TYPE binary not found; set $var_name in $SETTINGS_FILE first." >&2
        return 1
    fi
    require_config || return 1
    validate_config_security "$ACTIVE_CONFIG" || return 1
    require_privileged_path "$VPNCTL_HELPER" || return 1
    require_privileged_path "$ACTIVE_BIN" || return 1

    if [ "$VPN_TYPE" = "openvpn" ]; then
        tmpl="$(find_asset vpncli-openvpn.sudoers.template)" || {
            echo "Error: openvpn sudoers template not found near $SCRIPT_DIR." >&2; return 1; }

        for _p in "$VPNCTL_HELPER" "$OPENVPN" "$OPENVPN_CONFIG_PATH" "$OPENVPN_AUTH_FILE" "$TUNNEL_PID_FILE"; do
            case "$_p" in
                *[[:space:]]*)
                    echo "Error: this path contains whitespace, which breaks passwordless-sudo matching:" >&2
                    echo "  $_p" >&2
                    echo "Use a space-free location (e.g. set VPNCLI_CONFIG_DIR/VPNCLI_STATE_DIR) and retry." >&2
                    return 1 ;;
            esac
        done

        # Auth file must exist for visudo's own sanity, and to be a stable target;
        # actual contents are (re)written fresh on every launch.
        mkdir -p "$STATE_DIR"
        [ -f "$OPENVPN_AUTH_FILE" ] || : > "$OPENVPN_AUTH_FILE"
        chmod 600 "$OPENVPN_AUTH_FILE" 2>/dev/null

        tmp="$(mktemp "${TMPDIR:-/tmp}/vpncli.sudoers.XXXXXX")" || return 1
        render_template "$tmpl" \
            "__USER__=$(sudoers_escape "$USER")" \
            "__HELPER__=$(sudoers_escape "$VPNCTL_HELPER")" \
            "__OPENVPN__=$(sudoers_escape "$OPENVPN")" \
            "__OVPN_CONFIG__=$(sudoers_escape "$OPENVPN_CONFIG_PATH")" \
            "__AUTH_FILE__=$(sudoers_escape "$OPENVPN_AUTH_FILE")" \
            "__PID_FILE__=$(sudoers_escape "$TUNNEL_PID_FILE")" \
            > "$tmp"

        if ! visudo -cf "$tmp" >/dev/null 2>&1; then
            echo "Error: generated sudoers failed validation:" >&2
            visudo -cf "$tmp" >&2
            rm -f "$tmp"; return 1
        fi

        echo "Installing passwordless-sudo rule to $ACTIVE_SUDOERS_PATH (requires sudo):"
        echo "  user:    $USER"
        echo "  openvpn: $OPENVPN"
        echo "  config:  $OPENVPN_CONFIG_PATH"
        echo "  auth:    $OPENVPN_AUTH_FILE"
        echo "  helper:  $VPNCTL_HELPER"
    else
        require_privileged_path "$EXPECT_SCRIPT" || return 1
        tmpl="$(find_asset vpncli.sudoers.template)" || {
            echo "Error: sudoers template not found near $SCRIPT_DIR." >&2; return 1; }

        for _p in "$VPNCTL_HELPER" "$EXPECT_SCRIPT" "$OPENFORTIVPN" "$CONFIG_PATH" "$TUNNEL_PID_FILE"; do
            case "$_p" in
                *[[:space:]]*)
                    echo "Error: this path contains whitespace, which breaks passwordless-sudo matching:" >&2
                    echo "  $_p" >&2
                    echo "Use a space-free location (e.g. set VPNCLI_CONFIG_DIR) and retry." >&2
                    return 1 ;;
            esac
        done

        tmp="$(mktemp "${TMPDIR:-/tmp}/vpncli.sudoers.XXXXXX")" || return 1
        render_template "$tmpl" \
            "__USER__=$(sudoers_escape "$USER")" \
            "__HELPER__=$(sudoers_escape "$VPNCTL_HELPER")" \
            "__EXPECT__=$(sudoers_escape "$EXPECT_SCRIPT")" \
            "__OPENFORTIVPN__=$(sudoers_escape "$OPENFORTIVPN")" \
            "__CONFIG__=$(sudoers_escape "$CONFIG_PATH")" \
            "__PID_FILE__=$(sudoers_escape "$TUNNEL_PID_FILE")" \
            > "$tmp"

        if ! visudo -cf "$tmp" >/dev/null 2>&1; then
            echo "Error: generated sudoers failed validation:" >&2
            visudo -cf "$tmp" >&2
            rm -f "$tmp"; return 1
        fi

        echo "Installing passwordless-sudo rule to $ACTIVE_SUDOERS_PATH (requires sudo):"
        echo "  user:         $USER"
        echo "  openfortivpn: $OPENFORTIVPN"
        echo "  config:       $CONFIG_PATH"
        echo "  helper:       $VPNCTL_HELPER"
    fi

    if sudo install -m 0440 "$tmp" "$ACTIVE_SUDOERS_PATH"; then
        rm -f "$tmp"
        echo "Installed. Verify with: $PROG doctor"
    else
        rm -f "$tmp"
        echo "Failed to install sudoers rule." >&2; return 1
    fi
}

do_uninstall_sudoers() {
    if [ "${1:-}" = "--all" ]; then
        local p any=0
        for p in "${SUDOERS_PATH}-fortivpn" "${SUDOERS_PATH}-openvpn" "$SUDOERS_PATH"; do
            if [ -f "$p" ]; then
                echo "Removing $p (requires sudo)..."
                sudo rm -f "$p" && any=1
            fi
        done
        if [ "$any" -eq 1 ]; then echo "Removed."; else echo "No sudoers rules found."; fi
        return 0
    fi
    if [ -f "$ACTIVE_SUDOERS_PATH" ]; then
        echo "Removing $ACTIVE_SUDOERS_PATH (requires sudo)..."
        sudo rm -f "$ACTIVE_SUDOERS_PATH" && echo "Removed."
    elif [ -f "$SUDOERS_PATH" ]; then
        # Pre-multi-backend (unsuffixed) install layout.
        echo "Removing legacy $SUDOERS_PATH (requires sudo)..."
        sudo rm -f "$SUDOERS_PATH" && echo "Removed."
    else
        echo "No sudoers rule at $ACTIVE_SUDOERS_PATH"
    fi
}

do_setup() {
    local c imported cand ex ans
    echo "vpnCLI setup"
    echo
    repair_secret_backend || return 1
    if ! case "${VPN_TYPE:-}" in fortivpn|openvpn) true ;; *) false ;; esac; then
        echo "Invalid VPN_TYPE in $SETTINGS_FILE; defaulting to fortivpn for setup."
        VPN_TYPE="fortivpn"
    fi
    move_config_to_privileged_dir || return 1
    mkdir -p "$CONFIG_DIR" "$STATE_DIR"
    chmod 700 "$CONFIG_DIR" "$STATE_DIR" 2>/dev/null   # tighten if dirs pre-existed

    # 0. Backend
    echo "VPN backend (currently: $VPN_TYPE):"
    printf '  [1] fortivpn (openfortivpn)   [2] openvpn   [Enter = keep current] '
    read -r ans
    case "$ans" in
        1) VPN_TYPE="fortivpn"; settings_set VPN_TYPE fortivpn ;;
        2) VPN_TYPE="openvpn";  settings_set VPN_TYPE openvpn ;;
        *) ;;
    esac
    # Re-resolve the active binary/config for the (possibly just-changed) backend.
    if [ "$VPN_TYPE" = "openvpn" ]; then
        [ -z "$OPENVPN" ] && OPENVPN="$(detect_openvpn || true)"
    else
        [ -z "$OPENFORTIVPN" ] && OPENFORTIVPN="$(detect_openfortivpn || true)"
    fi
    resolve_active_backend
    echo

    install_privileged_assets || return 1

    # 1. Config
    case "$CONFIG_DIR" in
        "$HOME"/*)
            echo "Note: passwordless sudo requires the VPN config and every parent directory"
            echo "to be root-owned, readable by vpnctl, and not group/world-writable."
            echo "For the sudoers step, move the finished config to /etc/vpncli and set"
            echo "VPNCLI_CONFIG_DIR=/etc/vpncli in the environment, or run setup with that"
            echo "location already prepared."
            echo ;;
    esac
    echo "Note: passwordless sudo also requires the VPN executable and vpnctl-helper"
    echo "to be root-owned. Homebrew installs them in user-owned locations, so copy"
    echo "them to a protected path and set OPENVPN and VPNCTL_HELPER in settings"
    echo "before the sudoers step (see the README for the exact commands)."
    echo
    if [ "$VPN_TYPE" = "openvpn" ]; then
        if [ -r "$OPENVPN_CONFIG_PATH" ]; then
            echo "Config already present: $OPENVPN_CONFIG_PATH"
            if [ -z "$OPENVPN_USERNAME" ]; then prompt_openvpn_config; fi
        else
            ex="$(find_asset vpn.ovpn.example)" && cp "$ex" "$OPENVPN_CONFIG_PATH"
            echo "Created config from template: $OPENVPN_CONFIG_PATH"
            prompt_openvpn_config
        fi
        chmod 600 "$OPENVPN_CONFIG_PATH" 2>/dev/null
    else
        if [ -r "$CONFIG_PATH" ]; then
            echo "Config already present: $CONFIG_PATH"
        else
            # Only consider configs tied to the install/clone location — never the
            # current directory, so running setup elsewhere can't import a stray
            # vpn.conf. Confirm before importing so it's never a surprise.
            imported=""
            cand=""
            for c in "$SCRIPT_DIR/../vpn.conf" "$SCRIPT_DIR/vpn.conf"; do
                if [ -r "$c" ] && [ "$c" != "$CONFIG_PATH" ]; then cand="$c"; break; fi
            done
            if [ -n "$cand" ]; then
                printf 'Found an existing config at %s\n' "$cand"
                printf 'Import it into %s? [Y/n] ' "$CONFIG_PATH"
                read -r ans
                case "$ans" in
                    [Nn]*) ;;
                    *)     cp "$cand" "$CONFIG_PATH" && imported="$cand" ;;
                esac
            fi
            if [ -n "$imported" ]; then
                echo "Imported existing config: $imported → $CONFIG_PATH"
            else
                ex="$(find_asset vpn.conf.example)" && cp "$ex" "$CONFIG_PATH"
                echo "Created config from template: $CONFIG_PATH"
                prompt_config
            fi
        fi
        chmod 600 "$CONFIG_PATH" 2>/dev/null
    fi
    echo

    # 2. Password
    if secret_present password; then
        echo "VPN password already stored (service: $SECRET_SERVICE)."
        printf 'Re-enter it? [y/N] '; read -r ans
        case "$ans" in [Yy]*) do_set_password ;; esac
    else
        do_set_password
    fi
    echo

    # 2b. Optional TOTP (for gateways that want password+OTP concatenated)
    if secret_present otp; then
        echo "TOTP secret already stored — a code is appended to the password on connect."
        printf 'Re-enter it? [y/N] '; read -r ans
        case "$ans" in [Yy]*) do_set_otp_secret ;; esac
    else
        printf 'Does this VPN require a 6-digit OTP appended to the password? [y/N] '
        read -r ans
        case "$ans" in [Yy]*) do_set_otp_secret ;; esac
    fi
    echo

    # 3. Sudoers
    do_install_sudoers
    echo

    # 4. Diagnostics
    do_doctor
    echo
    echo "Tip: run this same 'setup' again with the other backend selected at the"
    echo "prompt above to provision it too (separate config, password, OTP secret,"
    echo "and sudoers rule — see backend-scoped notes above). With both"
    echo "provisioned, switch between them any time with: $PROG switch fortivpn|openvpn"
}

# ===========================================================================
# Post-config resolution (needs the functions above)
# ===========================================================================
if [ -z "$VPNCTL_HELPER" ]; then
    VPNCTL_HELPER="$(find_asset vpnctl-helper || true)"
fi
[ -z "$OPENFORTIVPN" ] && OPENFORTIVPN="$(detect_openfortivpn || true)"
[ -z "$OPENVPN" ]      && OPENVPN="$(detect_openvpn || true)"
EXPECT_SCRIPT="$(find_asset fortiVPN.expect || true)"
SECRET_BACKEND_RESOLVED="$(resolve_secret_backend || true)"

# Active backend selection: everything else (tunnel_running, teardown, doctor,
# sudoers) keys off ACTIVE_BIN/ACTIVE_CONFIG/ACTIVE_LAUNCH_CMD/
# ACTIVE_SUDOERS_PATH rather than branching on VPN_TYPE everywhere. A function
# (not an inline block) so `do_switch` can recompute these after flipping
# $VPN_TYPE at runtime, without forking a fresh process.
resolve_active_backend() {
    TUNNEL_PID_FILE="/var/run/vpncli-${USER}-${VPN_TYPE}.pid"
    case "$VPN_TYPE" in
        openvpn)
            ACTIVE_BIN="$OPENVPN"
            ACTIVE_CONFIG="$OPENVPN_CONFIG_PATH"
            ACTIVE_LAUNCH_CMD="$VPNCTL_HELPER start-openvpn $OPENVPN $OPENVPN_CONFIG_PATH $OPENVPN_AUTH_FILE $TUNNEL_PID_FILE"
            ACTIVE_STATUS_CMD="$VPNCTL_HELPER status $OPENVPN $OPENVPN_CONFIG_PATH $TUNNEL_PID_FILE"
            ACTIVE_STOP_CMD="$VPNCTL_HELPER stop $OPENVPN $OPENVPN_CONFIG_PATH $TUNNEL_PID_FILE"
            ;;
        fortivpn)
            ACTIVE_BIN="$OPENFORTIVPN"
            ACTIVE_CONFIG="$CONFIG_PATH"
            ACTIVE_LAUNCH_CMD="$VPNCTL_HELPER start-fortivpn $EXPECT_SCRIPT $OPENFORTIVPN $CONFIG_PATH $TUNNEL_PID_FILE"
            ACTIVE_STATUS_CMD="$VPNCTL_HELPER status $OPENFORTIVPN $CONFIG_PATH $TUNNEL_PID_FILE"
            ACTIVE_STOP_CMD="$VPNCTL_HELPER stop $OPENFORTIVPN $CONFIG_PATH $TUNNEL_PID_FILE"
            ;;
        *)
            ACTIVE_BIN=""
            ACTIVE_CONFIG=""
            ACTIVE_LAUNCH_CMD=""
            ACTIVE_STATUS_CMD=""
            ACTIVE_STOP_CMD=""
            ;;
    esac
    # Suffixed per backend (vpncli-fortivpn / vpncli-openvpn) so both backends'
    # passwordless-sudo rules can be installed and kept at once — switching
    # VPN_TYPE then never needs a fresh interactive `install-sudoers`.
    ACTIVE_SUDOERS_PATH="${SUDOERS_PATH}-${VPN_TYPE}"
}
resolve_active_backend

if [ "$VPNCTL_SOURCED" -eq 0 ]; then
    case "${1:-}" in
        -v|--version|version)
            printf '%s %s\n' "$PROG" "$VERSION"
            exit 0
            ;;
    esac
    if [ "${1:-}" != "setup" ] && ! validate_settings; then
        exit 1
    fi
    case "${1:-}" in
        start)             do_start ;;
        stop)              do_stop ;;
        restart)           do_restart ;;
        switch)            do_switch "${2:-}" ;;
        status)            do_status ;;
        routes)            do_routes ;;
        logs)              do_logs "${2:-}" ;;
        doctor)            do_doctor ;;
        setup)             do_setup ;;
        set-password)      do_set_password ;;
        set-otp-secret)    do_set_otp_secret ;;
        unset-otp-secret)  do_unset_otp_secret ;;
        install-sudoers)   do_install_sudoers ;;
        uninstall-sudoers) do_uninstall_sudoers "${2:-}" ;;
        __run__)           run_monitor ;;
        -h|--help|help)    usage ;;
        *)                 usage ;;
    esac
fi
